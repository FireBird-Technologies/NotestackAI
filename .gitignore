# Secrets: any .env at any depth, plus .env.local / .env.production etc. Templates stay tracked.
.env
.env.*
!.env.example
node_modules/
dist/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
out/
renderer/build/
.corpus-cache/
deploy/env.prod.example

# Local SQLite database
*.db
*.db-wal
*.db-shm

# Local object storage (used when no R2 is configured)
.storage/

# Local-only notes, not for the repo
/docs-local/
/docs/

# Production env template (kept local)
deploy/env.prod.example

# Chat evaluation results (backend/scripts/chat_eval.py)
backend/chat_eval_results/
