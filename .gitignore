# Secrets: any .env at any depth, plus .env.local / .env.production etc. Templates stay tracked.
.env
.env.*
!.env.example
node_modules/
dist/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
out/
renderer/build/
.corpus-cache/

# Local SQLite database
*.db
*.db-wal
*.db-shm

# Local object storage (used when no R2 is configured)
.storage/
