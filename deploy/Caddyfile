{
	email {$ACME_EMAIL}
}

# HTTPS certificates are issued and renewed automatically for API_DOMAIN (set in backend/.env).
{$API_DOMAIN} {
	encode zstd gzip

	reverse_proxy api:8000 {
		# Stream job progress and chat (server sent events) instead of buffering them.
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}

	# Uploads (voice samples, files) can be large.
	request_body {
		max_size 220MB
	}
}
